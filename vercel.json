{
  "version": 2,
  "builds": [
    {
      "src": "web_app/wsgi.py",
      "use": "@vercel/python",
      "config": {
        "maxLambdaSize": "250mb"
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "web_app/wsgi.py"
    }
  ],
  "functions": {
    "web_app/wsgi.py": {
      "includeFiles": "web_app/**/*"
    }
  }
}